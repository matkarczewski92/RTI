# Godot 4+ specific ignores
.godot/
# Android outputs and local signing material must never enter version control.
*.apk
*.aab
*.jks
*.keystore
**/export_credentials.cfg
**/google-services.json
/assets/**/.idea/
/android/*
!/android/.build_version
!/android/build/
/android/build/*
!/android/build/build.gradle
!/android/build/config.gradle
!/android/build/settings.gradle
!/android/build/gradle.properties
!/android/build/gradlew
!/android/build/gradlew.bat
!/android/build/gradle/
/android/build/gradle/*
!/android/build/gradle/wrapper/
/android/build/gradle/wrapper/*
!/android/build/gradle/wrapper/gradle-wrapper.properties
!/android/build/gradle/wrapper/gradle-wrapper.jar
!/android/build/src/
/android/build/src/*
!/android/build/src/main/
!/android/build/src/main/**
!/android/build/res/
/android/build/res/*
!/android/build/res/values/
/android/build/res/values/*
!/android/build/res/values/themes.xml
/.test_artifacts/
**/__pycache__/
/docs/*
!/docs/modernization/
!/docs/modernization/**
!/docs/ACTION_EXPERIENCE.md
!/docs/ANDROID_EXPORT.md
!/docs/GOOGLE_PLAY.md
!/docs/QA_CHECKLIST.md
!/docs/PRIVACY_POLICY_DRAFT.md
!/docs/CHANGELOG.md
!/docs/RELEASE_CHECKLIST.md
!/docs/RELEASE_NOTES_ANDROID_DEBUG.md
.test_artifacts/
android/
docs/
tests/
tools/
.claude/
.idea/
./vscode